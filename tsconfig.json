{
  "compilerOptions": {
    "outDir": "dist",
    "module": "NodeNext",
    "target": "ES2024",
    "moduleResolution": "NodeNext",
    "removeComments": true,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "sources/**/*.ts",
    "tests/**/*.ts"
  ]
}
